pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

-- sprites
trains_up = 7
trains_right = 8
trains_down = 9
trains_left = 10

-- train
train = {
    x = 0,
    y = 0,
    vx = 0,
    vy = 0,
    spr = trains_up,
    last_track_name = "",
    set_direction = function(self, x, y)
        self.vx = x
        self.vy = y
        if x > 0 then
            self.spr = trains_right
        elseif x < 0 then
            self.spr = trains_left
        elseif y > 0 then
            self.spr = trains_down
        elseif y < 0 then
            self.spr = trains_up
        end
    end
}

-- track pieces
track_vert = {
    spr = 1,
    name = 'vertical',
    on_active = function(train)
        if train.vy >= 0 then
            train:set_direction(0, 1)
        else
            train:set_direction(0, -1)
        end
    end
}

track_horiz = {
    spr = 2,
    name = 'horizontal',
    on_active = function(train)
        if train.vx >= 0 then
            train:set_direction(1, 0)
        else
            train:set_direction(-1, 0)
        end
    end
}

track_tl = {
    spr = 3,
    name = 'turn_top_left',
    on_active = function(train)
        if train.vy < 0 then
            train:set_direction(1, 0)
        else
            train:set_direction(0, 1)
        end
    end
}

track_tr = {
    spr = 4,
    name = 'turn_top_right',
    on_active = function(train)
        if train.vy < 0 then
            train:set_direction(-1, 0)
        else
            train:set_direction(0, 1)
        end
    end
}

track_br = {
    spr = 5,
    name = 'turn_bottom_right',
    on_active = function(train)
        if train.vy > 0 then
            train:set_direction(-1, 0)
        else
            train:set_direction(0, -1)
        end
    end
}


track_bl = {
    spr = 6,
    name = 'turn_bottom_left',
    on_active = function(train)
        if train.vy > 0 then
            train:set_direction(1, 0)
        else
            train:set_direction(0, -1)
        end
    end
}

track_by_spr = {
    [1] = track_vert,
    [2] = track_horiz,
    [3] = track_tl,
    [4] = track_tr,
    [5] = track_br,
    [6] = track_bl
}

function get_track_type(spr)
    return track_by_spr[spr]
end

function get_track_on_tile(x, y)
    local tile = mget(x, y)
    return get_track_type(tile)
end

function get_track_at(x, y)
    return get_track_on_tile(flr(x / 8), flr(y / 8))
end

function reset()
    local all_tracks = {}
    for i = 0, 14 do
        for j = 0, 14 do
            local t = get_track_on_tile(i, j)
            if t then
                add(all_tracks, { x = i, y = j, t = t })
            end
        end
    end

    local tile = rnd(all_tracks)
    assert(tile)

    train.x = tile.x * 8
    train.y = tile.y * 8
    tile.t.on_active(train)
    train.last_track_name = tile.t.name
end

function _init()
    reset()
end

function _update()
    if btnp(❎) then
        reset()
    end

    local dx = 0
    local dy = 0

    if train.vx < 0 then
        dx = 7
    end

    if train.vy < 0 then
        dy = 7
    end

    local track = get_track_at(train.x + dx, train.y + dy)
    if track and track.name != train.last_track_name then
        track.on_active(train)
        train.last_track_name = track.name
    end

    train.x += train.vx
    train.y += train.vy
end

function _draw()
    cls()
    map(0, 0, 0, 0, 15, 15)
    spr(train.spr, train.x, train.y)
    print("v( " .. train.vx .. ", " .. train.vy .. ") p(" .. train.x .. ", " .. train.y .. ")", 0, 0, 3)
    print(train.last_track_name, 0, 6, 3)
end
