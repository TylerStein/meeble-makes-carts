pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

phys_objs = {}
player =  {}

dbg_dist = 0
dbg_overlap = 0
dbg_interps = 0
dbg_ground = 0

flag_collision = 2

function tile_at(x, y)
    local tx = x/8
 	local ty = y/8
    return mget(tx, ty)
end

function is_solid(x, y)
    if fget(tile_at(x, y), flag_collision) then
        return true
    end
    return false
end

function init_phys_obj(x, y, w, h, spr, static)
    return {
        x = x,
        y = y,
        w = w,
        h = h,
        x2 = x + w,
        y2 = y + h,
        vx = 0,
        vy = 0,
        spr = spr,
        static = static
    }
end

function is_intersecting(a, b)
    if a.x2 > b.x and a.x < b.x2 then
        -- x overlap
        if a.y2 > b.y and a.y < b.y2 then
            -- y overlap
            return true
        end
    end
    return false
end

function lerp(x1, y1, x2, y2, t)
    return {
        x = x1 + t * (x2 - x1),
        y = y1 + t * (y2 - y1)
    }
end

function sign(v)
    if v < 0 then
        return -1
    end
    return 1
end

function check_collision_x(obj, dir)
    -- check for horizontal collision with world, dir should be -1 or 1
    local x_edge = obj.x2 - 1
    if dir < 0 then x_edge = obj.x end
    for y = obj.y, obj.y2 - 1 do
        -- scan top to bottom on moving side
        if is_solid(x_edge + dir, y) then
            -- return steps moved
            return true
        end
    end
    return false
end

function check_collision_y(obj, dir)
    -- check for vertical collision with world, dir should be -1 or 1
    local y_edge = obj.y2 - 1
    if dir < 0 then y_edge = obj.y end
    for x = obj.x, obj.x2 - 1 do
        -- scan left to right on moving side
        if is_solid(x, y_edge + dir) then
            -- return steps moved
            return true
        end
    end
    return false
end

function move_phys_obj_x(obj, d)
    -- move obj horizontally with per pixel collision detection
    local dir = sign(d)
    for i = 0, abs(d) do
        if check_collision_x(obj, dir) then 
            return (i - 1) * dir
        end

        obj.x += dir
        obj.x2 = obj.x + obj.w
    end
    return d
end

function move_phys_obj_y(obj, d)
    -- move obj vertically with per pixel collision detection
    local dir = sign(d)
    for i = 0, abs(d) do
        if check_collision_y(obj, dir) then
            return (i - 1) * dir
        end

        obj.y += dir
        obj.y2 = obj.y + obj.h
    end
    return d
end

function update_phys_obj(obj, other_phys_objs)
    -- move one pixel at a time (x then y) and stop before collision
    local dir_x = sign(obj.vx)
    local dir_y = sign(obj.vy)

    local vx_abs = abs(obj.vx)
    local vy_abs = abs(obj.vy)

    while vx_abs > 0 or vy_abs > 0 do
        if vx_abs > 0 then
            if move_phys_obj_x(obj, dir_x) != 0 then
                -- moved 1 px on x
                vx_abs -= 1
            else
                -- blocked on x
                vx_abs = 0
                obj.vx = 0
            end
        end

        if vy_abs > 0 then
            if move_phys_obj_y(obj, dir_y) != 0 then
                -- moved 1 px on y
                vy_abs -= 1
            else
                -- blocked on y
                vy_abs = 0
                obj.vy = 0
            end
        end
    end
end

function _init()
    player = init_phys_obj(64, 64, 8, 8, 1, false)
end

function _update()
    speed = 2
    
    local input_x = 0
    if btn(0) then
        input_x = -1
    elseif btn(1) then
        input_x = 1
    end

    -- local input_y = 0
    -- if btn(2) then
    --     input_y = -1
    -- elseif btn(3) then
    --     input_y = 1
    -- end
    -- if input_x != 0 and input_y != 0 then
    --     input_x *= 0.5
    --     input_y *= 0.5
    -- end

    player.vx = input_x * speed

    dbg_ground = 0
    local is_grounded = false
    if check_collision_y(player, 1) then
        dbg_ground = 1
        is_grounded = 1
        player.vy = 0
    elseif player.vy < 2 then
        player.vy += 1
    end

    update_phys_obj(player, phys_objs)

    if player.y > 128 then
        player.y -= 128
    elseif player.y < 0 then
        player.y += 128
    end

    if player.x > 128 then
        player.x -= 128
    elseif player.x < 0 then
        player.x += 128
    end
end

function _draw()
    cls(0)
    spr(1, player.x, player.y)
    map(0, 0, 0, 0, 15, 15)


    print("d = " .. dbg_dist, 2, 2, 1)
    print("o = " .. dbg_overlap, 2, 8, 1)
    print("i = " .. dbg_interps, 2, 14, 1)
    print("vx = " .. player.vx .. ", vy = " .. player.vy, 2, 20, 1)
    print("ground = " .. dbg_ground, 2, 28, 1)
end

