pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

btn_left = 0
btn_right = 1
btn_jump = 2
btn_fall = 3

gravity = 2

p_anims = {
    idle = {3},
    move = {1, 2},
    jump = {4}
}

player = {
    x = 64,
    y = 112,
    vx = 0,
    vy = 0,
    accel_x = 1,
    brake_x = 2,
    max_vx = 6,
    max_vy = 12,
    jump_force = 10,
    fast_fall = 3,
    slow_fall = 1,
    grounded = false,
    anim_frame = 1,
    anim = p_anims.idle,
}

obstacle_halls = {
    { 33 },
    { 38 },
    { 43 }
}

active_obstacle = {
    src = obstacle_halls[1],
    x = 160
}

firewall_edge_anim = { 128, 129, 130, 131}
firewall_inner_anim = { 132, 133, 134, 135 }
firewall_anim_frame = 1

firewall_speed = 0
firewall_x = 4

boundary_y = { 8, 112 }
boundary_x = { 8, 80 }

background_offset_x = 0
anim_rate = 2
anim_time = 0

function _init()

end

function reset_game()
    firewall_x = 4
    background_offset_x = 0
    anim_time = 0
    player.x = 64
    player.y = 112
    player.vx = 0
    player.vy = 0
    player.grounded = false
    player.anim_frame = 1
    player.anim = p_anims.idle
end

function _draw()
    cls(5)    

    map(0, 0, background_offset_x - 64, 0, 32, 16)
    map(active_obstacle.src[1], 0, active_obstacle.x, 0, 4, 16)

    spr(player.anim[player.anim_frame], player.x, player.y)

    -- draw firewall
    firewall_offset = firewall_x % 8
    for i = 1, 14 do
        local step = 0
        for j = -8 + firewall_offset, firewall_x do
            if step == 0 then
                step = 7

                if j + 8 > firewall_x then
                    spr(firewall_edge_anim[firewall_anim_frame], j, i * 8)
                else
                    spr(firewall_inner_anim[firewall_anim_frame], j, i * 8)
                end
            else
                step -= 1
            end


            -- if j > firewall_tiles - 1 then
            --     
            -- else
            -- end
        end
    end
   	
    -- print("camera " .. background_offset_x, 0, 0, 7)
    -- print("X " .. player.x .. " Y " .. player.y .. " VX " .. player.vx .. " VY " .. player.vy, 0, 0, 7)
    -- print("anim " .. player.anim[player.anim_frame] .. " (" .. player.anim_frame .. " of " .. #player.anim .. ")", 0, 6, 7)
end

function update_animations()
    -- update animations based on player state
    if player.vy < 0 then
        -- jumping
        player.anim = p_anims.jump
    elseif player.vx != 0 then
        -- moving
        player.anim = p_anims.move
    else
        --idle
        player.anim = p_anims.idle
    end

    -- play animations on a syncronized timer
    anim_time += 1
    if anim_time > anim_rate then
        anim_time = 0

        -- animate player
        if #player.anim > 1 then
            player.anim_frame += 1
            if player.anim_frame > #player.anim then
                player.anim_frame = 1
            end
        else
            player.anim_frame = 1
        end

        firewall_anim_frame += 1
        if firewall_anim_frame > #firewall_edge_anim then
            firewall_anim_frame = 1
        end
    end
end

function clamp(value, min, max)
    if value < min then return min
    elseif value > max then return max
    else return value end
end

function move_toward(value, target, amount)
    if value < target then
        return clamp(value + amount, value, target)
    elseif value > target then
        return clamp(value - amount, target, value)
    else
        return value
    end
end

function apply_boundaries()
    -- clamp player to y boundaries and handle velocity changes on floor/ceiling collision
    if player.y < boundary_y[1] then
        -- hit ceiling
        player.y = boundary_y[1]
        player.vy = 0
        player.grounded = false
    elseif player.y >= boundary_y[2] then
        -- hit floor
        player.y = boundary_y[2]
        player.vy = 0
        player.grounded = true
    else
        -- falling
        player.grounded = false
    end

    -- clamp player to x boundaries and "move" the camera to keep the player in the center of the screen
    if player.x < boundary_x[1] then
        -- move camera left
        player.x = boundary_x[1]
    elseif player.x > boundary_x[2] then
        -- move camera right
        local diff = player.x - boundary_x[2]
        player.x = boundary_x[2]
        background_offset_x -= diff
        firewall_x -= diff
        active_obstacle.x -= diff
    end
end

function _update()
    if btn(btn_right) then
        if player.vx >= 0 then
            player.vx = move_toward(player.vx, player.max_vx, player.accel_x)
        else
            player.vx = move_toward(player.vx, 0, player.brake_x)
        end
    elseif btn(btn_left) then
        if player.vx <= 0 then
            player.vx = move_toward(player.vx, -player.max_vx, player.accel_x)
        else
            player.vx = move_toward(player.vx, 0, player.brake_x)
        end
    else
        player.vx = move_toward(player.vx, 0, player.brake_x)
    end

    if btnp(btn_jump) and player.grounded then
        player.vy = player.jump_force * -1
    elseif not player.grounded then
        if btn(btn_fall) then
            player.vy = move_toward(player.vy, player.max_vy, player.fast_fall)
        elseif btn(btn_jump) then
            player.vy = move_toward(player.vy, player.max_vy, player.slow_fall)
        else
            player.vy = move_toward(player.vy, player.max_vy, gravity)
        end
    end

    player.x += player.vx
    player.y += player.vy

    apply_boundaries()

    player.vy = clamp(player.vy, -player.max_vy, player.max_vy)
    player.vx = clamp(player.vx, -player.max_vx, player.max_vx)

    update_animations()

    -- loop the background
    if background_offset_x < -64 then
        background_offset_x += 64
    elseif background_offset_x > 64 then
        background_offset_x -= 64
    end

    -- firewall behavior
    if firewall_x < 2 then
        firewall_x = 2
    else
        firewall_x += firewall_speed
    end

    -- obstacle behavior
    if active_obstacle.x < -32 then
        active_obstacle.x = 160
        active_obstacle.src = rnd(obstacle_halls)
    end

    if player.x <= firewall_x then
        reset_game()
    end
end

