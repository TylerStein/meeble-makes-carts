pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	px = 64 -- player x pos
	ps = 2 -- player speed
	pr = 8 -- player size
	bx = 127 - pr -- boundaries
	
	ctt = 12 -- shoot delay
	ct = 0 -- shoot timer

	ett = 42 -- spawn delay
	et = 0 -- spawn timer
	
	e = {} -- enemies
	b = {} -- bullets
	
	gameover = false
 score = 0
	music(1, 0)
end

function _update()
if gameover then
	if btnp(❎) then
	 -- reset the game
		score = 0
		music(1, 0)
		e = {}
		b = {}
		et = 0
		bt = 0
		px = 64
		gameover = false
	end

	return
end

-- move the player
if btn(➡️) then px += ps end
if btn(⬅️) then px -= ps end

-- stop player at x bounds
if (px < pr) then px = pr end 
if (px > bx) then px = bx end

if ct > 0 then
 -- shoot delay countdown
	ct -= 1
elseif btnp(❎) then
 -- spawn a bullet
	local pos = { px, bx }
	add(b, pos)
	
	-- reset shoot timer
	ct = ctt
end

if et > 0 then
 -- spawn delay countdown
	et -= 1
else
 -- spawn a enemy at rng x
	local r = rnd(bx - pr) + pr
	add(e, { r, pr })
	
	-- reset spawn timer
	et = ett 
end

for i in all(b) do
	-- move bullets up
	i[2] = i[2] - 1
	
	-- remove bullets off screen
	if i[2] < 0 then
		del(b, i)
	end
end

for i in all(e) do
 -- move enemies down
	i[2] = i[2] + 1
	
	-- check if enemy hit bottom
	if i[2] >= bx then
		gameover = true
		music(0, 0)
	end
	
	-- calculate enemy bounds
	local ixmin = i[1] - 4
 local	ixmax = i[1] + 4
 local iymin = i[2] - 4
 local iymax = i[2] + 4
	
	-- check if bullet hit enemy
	for j in all(b) do
		if j[1] > ixmin and j[1] < ixmax and j[2] > iymin and j[2] < iymax then
			-- destroy bullet and enemy
			del(b, j)
			del(e, i)
			score += 1
		end
	end
end


end

function _draw()
	-- clear screen
	cls(1)
	
	-- draw player
	spr(1, px, bx)
	
	-- draw enemies
	for i in all(e) do
		spr(2, i[1], i[2])
	end
	
	-- draw bullets
	for i in all(b) do
		spr(0, i[1], i[2])
	end
	
	if gameover then
		print("game over", 44, 52)
		print("final score", 44, 60)
		print(score, 44, 68)
		print("❎ to try again", 44, 82)
	else
		print("score", 4, 4)
		print(score, 32, 4)
	end	
end
